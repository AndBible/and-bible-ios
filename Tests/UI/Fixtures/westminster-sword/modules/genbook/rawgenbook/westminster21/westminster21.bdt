              <hi type="italic"><reference osisRef="Rom.10.13-Rom.10.14">Romans 10:13-14</reference>; <reference osisRef="Hos.4.12">Hosea 4:12</reference>; <reference osisRef="Acts.10.25-Acts.10.26">Acts 10:25-26</reference>; <reference osisRef="Rev.19.10">Revelation 19:10</reference>; <reference osisRef="Matt.4.10">Matthew 4:10</reference>; <reference osisRef="Col.2.18">Colossians 2:18</reference>; <reference osisRef="Rom.1.25">Romans 1:25</reference>; </hi>
