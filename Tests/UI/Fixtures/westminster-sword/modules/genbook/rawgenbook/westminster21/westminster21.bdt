              <hi type="sub">g</hi>
              <hi type="italic"><reference osisRef="Ps.50.16-Ps.50.17">Psalm 50:16-17</reference>; </hi>
              <hi type="sub">h</hi>
              <hi type="italic"><reference osisRef="Isa.5.12">Isaiah 5:12</reference>; </hi>
              <hi type="sub">i</hi>
              <hi type="italic"><reference osisRef="2Kgs.19.22">2 Kings 19:22</reference>; <reference osisRef="Lev.24.11">Leviticus 24:11</reference>; </hi>
              <hi type="sub">j</hi>
              <hi type="italic"><reference osisRef="Zech.5.4">Zechariah 5:4</reference>; <reference osisRef="Zech.8.17">Zechariah 8:17</reference>; </hi>
              <hi type="sub">k</hi>
              <hi type="italic"><reference osisRef="1Sam.17.43">1 Samuel 17:43</reference>; <reference osisRef="2Sam.16.5">2 Samuel 16:5</reference>; </hi>
              <hi type="sub">l</hi>
              <hi type="italic"><reference osisRef="Jer.5.7">Jeremiah 5:7</reference>; <reference osisRef="Jer.23.10">Jeremiah 23:10</reference>; </hi>
              <hi type="sub">m</hi>
              <hi type="italic"><reference osisRef="Deut.23.18">Deuteronomy 23:18</reference>; <reference osisRef="Acts.23.12">Acts 23:12</reference>, <reference osisRef="Acts.23.14">14</reference>; </hi>
              <hi type="sub">n</hi>
              <hi type="italic"><reference osisRef="Esth.3.7">Esther 3:7</reference>; <reference osisRef="Esth.9.24">Esther 9:24</reference>; <reference osisRef="Ps.22.18">Psalm 22:18</reference>; </hi>
              <hi type="sub">o</hi>
              <hi type="italic"><reference osisRef="Ps.24.4">Psalm 24:4</reference>; <reference osisRef="Ezek.17.16">Ezekiel 17:16</reference>, <reference osisRef="Ezek.17.18-Ezek.17.19">18-19</reference>; </hi>
              <hi type="sub">p</hi>
              <hi type="italic"><reference osisRef="Mark.6.26">Mark 6:26</reference>; <reference osisRef="1Sam.25.22">1 Samuel 25:22</reference>, <reference osisRef="1Sam.25.32-1Sam.25.34">32-34</reference>; </hi>
              <hi type="sub">q</hi>
              <hi type="italic"><reference osisRef="Rom.9.14">Romans 9:14</reference>, <reference osisRef="Rom.9.19-Rom.9.20">19-20</reference>; </hi>
              <hi type="sub">r</hi>
              <hi type="italic"><reference osisRef="Deut.29.29">Deuteronomy 29:29</reference>; </hi>
              <hi type="sub">s</hi>
              <hi type="italic"><reference osisRef="Rom.3.5">Romans 3:5</reference>, <reference osisRef="Rom.3.7">7</reference>; <reference osisRef="Rom.6.1">Romans 6:1</reference>; </hi>
              <hi type="sub">t</hi>
