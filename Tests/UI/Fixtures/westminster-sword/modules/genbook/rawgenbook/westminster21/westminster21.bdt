              <hi type="sub">x</hi>
              <hi type="italic"><reference osisRef="Isa.22.13">Isaiah 22:13</reference>; <reference osisRef="Jer.23.34">Jeremiah 23:34</reference>, <reference osisRef="Jer.23.36">36</reference>, <reference osisRef="Jer.23.38">38</reference>; </hi>
              <hi type="sub">y</hi>
              <hi type="italic"><reference osisRef="1Tim.1.4">1 Timothy 1:4</reference>, <reference osisRef="1Tim.1.6-1Tim.1.7">6-7</reference>; <reference osisRef="1Tim.6.4-1Tim.6.5">1 Timothy 6:4-5</reference>, <reference osisRef="1Tim.6.20">20</reference>;  <reference osisRef="2Tim.2.14">2 Timothy 2:14</reference>; <reference osisRef="Titus.3.9">Titus 3:9</reference>; </hi>
              <hi type="sub">z</hi>
              <hi type="italic"><reference osisRef="Deut.18.10-Deut.18.14">Deuteronomy 18:10-14</reference>; <reference osisRef="Acts.19.13">Acts 19:13</reference>; </hi>
              <hi type="sub">aa</hi>
              <hi type="italic"><reference osisRef="2Tim.4.3-2Tim.4.4">2 Timothy 4:3-4</reference>; <reference osisRef="Rom.13.13-Rom.13.14">Romans 13:13-14</reference>; <reference osisRef="1Kgs.21.9-1Kgs.21.10">1 Kings 21:9-10</reference>; <reference osisRef="Jude.1.4">Jude 4</reference>;</hi>
              <hi type="sub"> ab</hi>
