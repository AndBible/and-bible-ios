              <hi type="sub">e</hi>
              <hi type="italic"><reference osisRef="1Sam.4.3-1Sam.4.5">1 Samuel 4:3-5</reference>; <reference osisRef="Jer.7.4">Jeremiah 7:4</reference>, <reference osisRef="Jer.7.9-Jer.7.10">9-10</reference>, <reference osisRef="Jer.7.14">14</reference>, <reference osisRef="Jer.7.31">31</reference>; <reference osisRef="Col.2.20-Col.2.22">Colossians 2:20-22</reference>; </hi>
              <hi type="sub">f</hi>
