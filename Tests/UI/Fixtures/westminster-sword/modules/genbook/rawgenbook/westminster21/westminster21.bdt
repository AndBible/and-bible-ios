              <hi type="sub">s</hi>
              <hi type="italic"><reference osisRef="1Sam.13.11-1Sam.13.12">1 Samuel 13:11-12</reference>; <reference osisRef="1Sam.15.21">1 Samuel 15:21</reference>; </hi>
