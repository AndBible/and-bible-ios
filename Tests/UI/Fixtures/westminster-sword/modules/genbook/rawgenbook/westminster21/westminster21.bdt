              <hi type="italic"><reference osisRef="Jer.7.8-Jer.7.10">Jeremiah 7:8-10</reference>; <reference osisRef="Prov.7.14-Prov.7.15">Proverbs 7:14-15</reference>; <reference osisRef="John.13.27">John 13:27</reference>, <reference osisRef="John.13.30">30</reference>; </hi>
