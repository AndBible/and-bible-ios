"ai_disclaimer_point3" = "Ponosisz odpowiedzialność za sposób wykorzystania treści generowanych przez AI. Zawsze weryfikuj wyniki w oparciu o Pismo Święte przed ich użyciem.";
"ai_disclaimer_point4" = "AndBible stara się ułatwiać weryfikację (np. precyzyjne cytaty źródłowe w komentarzach), ale ostateczna odpowiedzialność zawsze spoczywa na Tobie.";
"ai_disclaimer_point5" = "„Wszystko badajcie, a co szlachetne, zachowujcie.\" (1 Tesaloniczan 5:21)";
"ai_disclaimer_point6" = "Narzędzia te nie mają duszy ani Ducha Świętego. Są narzędziami do przetwarzania tekstu, a nie duchowymi przewodnikami. Nie nadają się do bezpośredniego przygotowywania kazań, nabożeństw ani innych treści duchowych bez starannego nadzoru człowieka, modlitwy i rozeznania.";
"ai_disclaimer_point7" = "Używane mądrze, mogą być pomocne dla wielu użytkowników i zastosowań. Jeśli jednak nie jesteś pewien, czy chcesz podjąć to ryzyko, rezygnacja z ich używania jest równie dobrym wyborem.";
"ai_disclaimer_point8" = "Twoje dane są wysyłane na serwery wybranego przez Ciebie dostawcy AI. Używając klucza API, akceptujesz warunki i politykę prywatności tego dostawcy. Modele hostowane lokalnie są możliwe, ale wymagają większej wiedzy technicznej i mogą nie dawać równie dobrych wyników jak modele komercyjne.";
"ai_disclaimer_point9" = "Dostawcy AI pobierają opłaty za korzystanie z API. Szacunki kosztów pokazywane w AndBible są przybliżone — zawsze sprawdzaj faktyczne opłaty u swojego dostawcy.";
"ai_disclaimer_responsibility" = "Są to jednak nadal potężne narzędzia — a z wielką mocą wiąże się wielka odpowiedzialność. Pamiętaj o następujących kwestiach.";
