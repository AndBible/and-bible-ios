"ai_disclaimer_point2" = "AI प्रतिक्रियाएं उनके प्रशिक्षण डेटा से पूर्वाग्रह को दर्शा सकती हैं, जानबूझकर भ्रामक हो सकती हैं, या किसी विशेष धार्मिक दृष्टिकोण को तटस्थ या संपूर्ण के रूप में प्रस्तुत कर सकती हैं।";
"ai_disclaimer_point3" = "आप AI-जनित सामग्री के उपयोग के लिए जिम्मेदार हैं। उन पर भरोसा करने से पहले हमेशा शास्त्र के विरुद्ध परिणामों की जांच करें।";
"ai_disclaimer_point4" = "AndBible सत्यापन को आसान बनाने का प्रयास करता है (जैसे कमेंटरी में सटीक स्रोत उद्धरण), लेकिन अंतिम जिम्मेदारी हमेशा आपकी होती है।";
"ai_disclaimer_point5" = "\"सब बातों को परखो; जो अच्छा हो उसे थामे रहो।\" (1 थिस्सलुनीकियों 5:21)";
"ai_disclaimer_point6" = "इन उपकरणों में कोई आत्मा नहीं है और कोई पवित्र आत्मा नहीं है। ये टेक्स्ट-प्रसंस्करण उपकरण हैं, आध्यात्मिक मार्गदर्शक नहीं। ये सावधानीपूर्वक मानवीय निगरानी, प्रार्थना और विवेक के बिना उपदेश, भक्ति या अन्य आध्यात्मिक सामग्री सीधे तैयार करने के लिए उपयुक्त नहीं हैं।";
"ai_disclaimer_point7" = "बुद्धिमानी से उपयोग किए जाने पर, ये कई उपयोगकर्ताओं और उपयोग मामलों के लिए लाभदायक हो सकते हैं। लेकिन यदि आप जोखिमों को स्वीकार करने के बारे में अनिश्चित हैं, तो उनका उपयोग न करना भी एक बिल्कुल वैध विकल्प है।";
"ai_disclaimer_point8" = "आपका डेटा आपके चुने हुए AI प्रदाता के सर्वर पर भेजा जाता है। API key का उपयोग करके, आप उस प्रदाता की शर्तों और गोपनीयता नीति को स्वीकार करते हैं। Self-hosted मॉडल संभव हैं लेकिन अधिक तकनीकी विशेषज्ञता की आवश्यकता है, और व्यावसायिक मॉडलों जितने अच्छे परिणाम नहीं दे सकते।";
"ai_disclaimer_point9" = "AI प्रदाता API उपयोग के लिए शुल्क लेते हैं। AndBible में दिखाए गए लागत अनुमान लगभग हैं — वास्तविक शुल्क के लिए हमेशा अपने प्रदाता की बिलिंग जांचें।";
"ai_disclaimer_responsibility" = "हालांकि, ये अभी भी शक्तिशाली उपकरण हैं — और महान शक्ति के साथ महान जिम्मेदारी आती है। कृपया निम्नलिखित बातों को ध्यान में रखें।";
