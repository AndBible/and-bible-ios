"ai_disclaimer_approach" = "AndBible முதன்மையாக மாடலின் சொந்த பயிற்சி தரவை நம்புவதை விட நீங்கள் நிறுவிய ஆவணங்களிலிருந்து — விளக்க உரைகள், அகராதிகள் மற்றும் பிற தொகுதிகளிலிருந்து — உரையை செயலாக்க AI பயன்படுத்துகிறது.";
"ai_disclaimer_dialog_title" = "AI கருவிகள் — முக்கிய தகவல்";
"ai_disclaimer_intro" = "AI கருவிகள் உங்கள் விவிலிய ஆய்வு அனுபவத்தை மிகவும் செழுமையாக்கி வேத வாசிப்பில் புதிய வழிகளை திறக்கலாம்.";
"ai_disclaimer_point1" = "AI தவறுகள் செய்யலாம், \"மாயக்கற்பனைகள்\" உட்பட (தவறான அல்லது உருவாக்கப்பட்ட தகவலை நம்பிக்கையுடன் கூறுவது). அதன் வெளியீட்டை குருட்டாமலாக ஏற்காதீர்கள்.";
"ai_disclaimer_point2" = "AI பதில்கள் பயிற்சி தரவிலிருந்து சார்புகளை பிரதிபலிக்கலாம், வேண்டுமென்றே தவறாக வழிநடத்தலாம், அல்லது ஒரு குறிப்பிட்ட இறையியல் கண்ணோட்டத்தை நடுநிலையானது அல்லது முழுமையானது என்பது போல் காட்டலாம்.";
"ai_disclaimer_point3" = "AI-உருவாக்கிய உள்ளடக்கத்தை எப்படி பயன்படுத்துகிறீர்கள் என்பதற்கு நீங்களே பொறுப்பாவீர்கள். முடிவுகளை வேதாகமத்துடன் எப்போதும் சரிபார்க்கவும்.";
"ai_disclaimer_point4" = "AndBible சரிபார்ப்பை எளிதாக்க முயற்சிக்கிறது (உதா. விளக்க உரைகளில் துல்லியமான மூல மேற்கோள்கள்), ஆனால் இறுதி பொறுப்பு எப்போதும் உங்களிடமே உள்ளது.";
"ai_disclaimer_point5" = "\\\"அனைத்தையும் சோதியுங்கள்; நல்லதை வைத்திருங்கள்.\\\" (1 தெசலோனிக்கியர் 5:21)";
"ai_disclaimer_point6" = "இந்த கருவிகளுக்கு ஆன்மா இல்லை, பரிசுத்த ஆவி இல்லை. அவை உரை-செயலாக்கக் கருவிகள், ஆவிக்குரிய வழிகாட்டிகள் அல்ல. சரியான மனித மேற்பார்வை, ஜெபம் மற்றும் விவேகம் இல்லாமல் பிரசங்கங்கள், பக்தி நூல்கள் அல்லது பிற ஆவிக்குரிய உள்ளடக்கத்தை நேரடியாக தயாரிக்க அவை பொருத்தமானவை அல்ல.";
"ai_disclaimer_point7" = "புத்திசாலித்தனமாக பயன்படுத்தினால், அவை பல பயனர்களுக்கும் பயன் தரும். ஆனால் அபாயங்களை ஏற்றுக்கொள்வது குறித்து உறுதியில்லை என்றால், அவற்றை பயன்படுத்தாமல் இருப்பதும் முற்றிலும் சரியான தேர்வு.";
"ai_disclaimer_point8" = "உங்கள் தரவு தேர்ந்தெடுத்த AI வழங்குனரின் சேவையகங்களுக்கு அனுப்பப்படுகிறது. API திறவை பயன்படுத்துவதன் மூலம், அந்த வழங்குனரின் விதிமுறைகளையும் தனியுரிமைக் கொள்கையையும் ஏற்கிறீர்கள். சொந்த-ஹோஸ்ட் மாடல்கள் சாத்தியம், ஆனால் அதிக தொழில்நுட்ப நிபுணத்துவம் தேவை, மற்றும் வணிக மாடல்களைப் போல் நல்ல முடிவுகளை தர முடியாமல் போகலாம்.";
"ai_disclaimer_point9" = "AI வழங்குனர்கள் API பயன்பாட்டிற்கு கட்டணம் வசூலிக்கிறார்கள். AndBible-இல் காட்டப்படும் செலவு மதிப்பீடுகள் தோராயமானவை — உண்மையான கட்டணங்களுக்கு எப்போதும் உங்கள் வழங்குனரின் பில்லிங்கை சரிபார்க்கவும்.";
"ai_disclaimer_responsibility" = "ஆயினும், அவை இன்னும் சக்திவாய்ந்த கருவிகள் — மற்றும் சிறந்த சக்தியுடன் பெரும் பொறுப்பு வருகிறது. பின்வருவனவற்றை மனதில் வையுங்கள்.";
