"ai_disclaimer_intro" = "Yapay zeka araçları, Kutsal Kitap çalışma deneyiminizi büyük ölçüde zenginleştirebilir ve Kutsal Yazılarla yeni yollarla etkileşim kurmanıza olanak tanır.";
"ai_disclaimer_point1" = "Yapay zeka, \"halüsinasyonlar\" (yanlış veya uydurma bilgileri güvenle belirtme) dahil hatalar yapabilir. Çıktısını körü körüne kabul etmeyin.";
"ai_disclaimer_point2" = "Yapay zeka yanıtları, eğitim verilerinden kaynaklanan önyargıları yansıtabilir, kasıtlı olarak yanıltıcı olabilir ya da belirli bir teolojik bakış açısını tarafsız veya eksiksiz gibi sunabilir.";
"ai_disclaimer_point3" = "Yapay zeka tarafından üretilen içeriği nasıl kullandığınızdan siz sorumlusunuz. Güvenmeden önce sonuçları her zaman Kutsal Yazı ile doğrulayın.";
"ai_disclaimer_point4" = "AndBible, doğrulamayı kolaylaştırmaya çalışır (örn. tefsirlerde kesin kaynak alıntıları), ancak nihai sorumluluk her zaman size aittir.";
"ai_disclaimer_point5" = "\"Her şeyi sınayın; iyiye sıkı sarılın.\" (1. Selanikliler 5:21)";
"ai_disclaimer_point6" = "Bu araçların ruhu ve Kutsal Ruhu yoktur. Bunlar metin işleme araçlarıdır, ruhsal rehberler değil. Dikkatli bir insan gözetimi, dua ve sezgi olmadan doğrudan vaazlar, adanmalar veya diğer ruhsal içerikler hazırlamak için uygun değildir.";
"ai_disclaimer_point7" = "Akıllıca kullanıldığında birçok kullanıcı ve kullanım senaryosuna fayda sağlayabilirler. Ancak riskleri kabul etmekten emin değilseniz, bunları kullanmamayı seçmek de tamamen geçerli bir tercihtir.";
"ai_disclaimer_point8" = "Verileriniz seçtiğiniz yapay zeka sağlayıcısının sunucularına gönderilir. Bir API anahtarı kullanarak o sağlayıcının koşullarını ve gizlilik politikasını kabul etmiş olursunuz. Kendi sunucunuzda barındırılan modeller mümkündür ancak daha fazla teknik uzmanlık gerektirir ve ticari modeller kadar iyi sonuçlar vermeyebilir.";
"ai_disclaimer_point9" = "Yapay zeka sağlayıcıları API kullanımı için ücret alır. AndBible'da gösterilen maliyet tahminleri yaklaşıktır — gerçek ücretler için sağlayıcınızın faturasını kontrol edin.";
"ai_disclaimer_responsibility" = "Ancak bunlar hâlâ güçlü araçlardır — ve büyük güç büyük sorumluluk getirir. Lütfen aşağıdakileri aklınızda bulundurun.";
