"ai_disclaimer_point1" = "AI غلطیاں کر سکتا ہے، بشمول \"ہیلوسینیشن\" (اعتماد کے ساتھ جھوٹی یا من گھڑت معلومات بیان کرنا)۔ اس کی پیداوار کو کبھی آنکھ بند کر کے قبول نہ کریں۔";
"ai_disclaimer_point2" = "AI کے جوابات ان کے تربیتی ڈیٹا سے تعصبات کی عکاسی کر سکتے ہیں، جان بوجھ کر گمراہ کن ہو سکتے ہیں، یا کسی مخصوص الہیاتی نقطہ نظر کو غیر جانب دار یا مکمل کے طور پر پیش کر سکتے ہیں۔";
"ai_disclaimer_point3" = "آپ AI سے تیار مواد استعمال کرنے کے ذمہ دار ہیں۔ ان پر انحصار کرنے سے پہلے ہمیشہ نتائج کو کلام پاک کے خلاف جانچیں۔";
"ai_disclaimer_point4" = "AndBible تصدیق کو آسان بنانے کی کوشش کرتا ہے (مثلاً تفسیروں میں درست ذریعہ حوالہ جات)، لیکن آخری ذمہ داری ہمیشہ آپ پر ہے۔";
"ai_disclaimer_point5" = "\"سب کچھ جانچو؛ جو اچھا ہو اسے تھامے رہو۔\" (1 تھسلنیکیوں 5:21)";
"ai_disclaimer_point6" = "ان ٹولز کی کوئی روح نہیں اور روح القدس نہیں۔ وہ متن پروسیسنگ ٹولز ہیں، روحانی رہنما نہیں۔ وہ احتیاطی انسانی نگرانی، دعا اور فراست کے بغیر براہ راست خطبے، عقیدتی مواد، یا دیگر روحانی مواد تیار کرنے کے لیے موزوں نہیں ہیں۔";
"ai_disclaimer_point7" = "عقلمندی سے استعمال کیے جائیں تو یہ بہت سے صارفین اور استعمالات کو فائدہ دے سکتے ہیں۔ لیکن اگر آپ خطرات قبول کرنے کے بارے میں غیر یقینی ہیں تو انہیں استعمال نہ کرنا بھی بالکل درست انتخاب ہے۔";
"ai_disclaimer_point8" = "آپ کا ڈیٹا آپ کے منتخب AI فراہم کنندہ کے سرورز پر بھیجا جاتا ہے۔ API کلید استعمال کر کے آپ اس فراہم کنندہ کی شرائط اور رازداری پالیسی سے متفق ہوتے ہیں۔ خود میزبان ماڈل ممکن ہیں لیکن زیادہ تکنیکی مہارت درکار ہے اور تجارتی ماڈلز جتنے اچھے نتائج نہیں دے سکتے۔";
"ai_disclaimer_point9" = "AI فراہم کنندگان API استعمال کا معاوضہ لیتے ہیں۔ AndBible میں دکھائے گئے لاگت کے تخمینے تقریبی ہیں — اصل معاوضوں کے لیے اپنے فراہم کنندہ کی بلنگ چیک کریں۔";
"ai_disclaimer_responsibility" = "تاہم، وہ اب بھی طاقتور ٹولز ہیں — اور بڑی طاقت کے ساتھ بڑی ذمہ داری آتی ہے۔ براہ کرم مندرجہ ذیل باتیں ذہن میں رکھیں۔";
