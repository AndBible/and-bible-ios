"ai_disclaimer_point1" = "AI có thể mắc sai lầm, bao gồm \"ảo giác\" (tự tin trình bày thông tin sai hoặc bịa đặt). Đừng bao giờ chấp nhận kết quả của AI một cách mù quáng.";
"ai_disclaimer_point2" = "Phản hồi của AI có thể phản ánh sự thiên lệch từ dữ liệu huấn luyện, có thể gây hiểu nhầm có chủ ý, hoặc có thể trình bày một quan điểm thần học cụ thể như thể đó là quan điểm trung lập hoặc toàn diện.";
"ai_disclaimer_point3" = "Bạn chịu trách nhiệm về cách sử dụng nội dung do AI tạo ra. Luôn xác minh kết quả với Kinh Thánh trước khi tin tưởng vào chúng.";
"ai_disclaimer_point4" = "AndBible cố gắng giúp việc xác minh dễ dàng (ví dụ: trích dẫn nguồn chính xác trong chú giải), nhưng trách nhiệm cuối cùng luôn thuộc về bạn.";
"ai_disclaimer_point5" = "\"Hãy thử nghiệm mọi sự; giữ lấy điều thiện.\" (1 Tê-sa-lô-ni-ca 5:21)";
"ai_disclaimer_point6" = "Những công cụ này không có linh hồn và không có Đức Thánh Linh. Chúng là công cụ xử lý văn bản, không phải người hướng dẫn tâm linh. Chúng không phù hợp để trực tiếp chuẩn bị bài giảng, bài suy ngẫm, hay các nội dung tâm linh khác mà không có sự giám sát cẩn thận của con người, cầu nguyện và phân định.";
"ai_disclaimer_point7" = "Được sử dụng khôn ngoan, chúng có thể mang lại lợi ích cho nhiều người dùng và trường hợp sử dụng. Nhưng nếu bạn không chắc về việc chấp nhận các rủi ro, việc chọn không sử dụng chúng cũng là một lựa chọn hoàn toàn hợp lệ.";
"ai_disclaimer_point8" = "Dữ liệu của bạn được gửi đến máy chủ của nhà cung cấp AI mà bạn chọn. Bằng cách sử dụng khóa API, bạn chấp nhận các điều khoản và chính sách bảo mật của nhà cung cấp đó. Các mô hình tự lưu trữ là khả thi nhưng đòi hỏi nhiều kiến thức kỹ thuật hơn và có thể không cho kết quả tốt như các mô hình thương mại.";
"ai_disclaimer_point9" = "Các nhà cung cấp AI tính phí sử dụng API. Ước tính chi phí hiển thị trong AndBible chỉ là xấp xỉ — hãy luôn kiểm tra hóa đơn của nhà cung cấp để biết chi phí thực tế.";
"ai_disclaimer_responsibility" = "Tuy nhiên, đây vẫn là những công cụ mạnh mẽ — và quyền năng lớn đi kèm trách nhiệm lớn. Xin hãy ghi nhớ những điều sau.";
