"ai_disclaimer_point2" = "DI atsakymai gali atspindėti šališkumą iš jų mokymo duomenų, būti tyčia klaidinantys arba pateikti tam tikrą teologinę perspektyvą tarsi ji būtų neutrali ar išsami.";
"ai_disclaimer_point3" = "Jūs esate atsakingi už tai, kaip naudojate DI sukurtą turinį. Prieš remdamiesi rezultatais, visada patikrinkite juos pagal Šventąjį Raštą.";
"ai_disclaimer_point4" = "AndBible siekia padaryti tikrinimą lengvą (pvz., tikslios šaltinio citatos komentaruose), tačiau galutinė atsakomybė visada tenka jums.";
"ai_disclaimer_point5" = "„Visa ištirkite, kas gera — laikykitės.\" (1 Tesalonikiečiams 5:21)";
"ai_disclaimer_point6" = "Šie įrankiai neturi sielos ir Šventosios Dvasios. Tai teksto apdorojimo įrankiai, ne dvasiniai vadovai. Jie netinka tiesiogiai rengti pamokslams, pamaldoms ar kitam dvasiniam turiniui be atidžios žmogaus priežiūros, maldos ir įžvalgos.";
"ai_disclaimer_point7" = "Naudojami išmintingai, jie gali būti naudingi daugeliui vartotojų ir atvejų. Tačiau jei nesate tikri dėl rizikos priėmimo, nepradėti jų naudoti taip pat yra visiškai tinkamas pasirinkimas.";
"ai_disclaimer_point8" = "Jūsų duomenys siunčiami į jūsų pasirinkto DI tiekėjo serverius. Naudodami API raktą, sutinkate su to tiekėjo sąlygomis ir privatumo politika. Vietoje talpinami modeliai yra įmanomi, tačiau reikalauja daugiau techninių žinių ir gali duoti ne tokius gerus rezultatus kaip komerciniai modeliai.";
"ai_disclaimer_point9" = "DI tiekėjai ima mokestį už API naudojimą. AndBible rodomos sąnaudų apytikslės — visada tikrinkite savo tiekėjo sąskaitą dėl faktinių mokesčių.";
"ai_disclaimer_responsibility" = "Tačiau tai vis tiek galingi įrankiai — o didelė galia reikalauja didelės atsakomybės. Prašome turėti omenyje toliau pateiktus dalykus.";
