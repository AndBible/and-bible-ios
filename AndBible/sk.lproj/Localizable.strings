"ai_disclaimer_point3" = "Ste zodpovední za to, ako používate obsah generovaný AI. Vždy overte výsledky podľa Písma skôr, ako sa na ne spoliehate.";
"ai_disclaimer_point4" = "AndBible sa snaží uľahčiť overovanie (napr. presné citácie zdrojov v komentároch), ale konečná zodpovednosť vždy leží na vás.";
"ai_disclaimer_point5" = "\"Skúmajte všetko, dobrého sa držte.\" (1. Tesalonickým 5:21)";
"ai_disclaimer_point6" = "Tieto nástroje nemajú dušu ani Svätého Ducha. Sú to nástroje na spracovanie textu, nie duchovní sprievodcovia. Nie sú vhodné na priame pripravovanie kázní, pobožností ani iného duchovného obsahu bez starostlivého ľudského dohľadu, modlitby a rozlišovania.";
"ai_disclaimer_point7" = "Ak sa používajú múdro, môžu prospieť mnohým používateľom a prípadom použitia. Ak si však nie ste istí prijatím rizík, je tiež úplne platnou voľbou ich nepoužívať.";
"ai_disclaimer_point8" = "Vaše údaje sú odosielané na servery vami zvoleného poskytovateľa AI. Použitím API kľúča prijímate podmienky a zásady ochrany súkromia daného poskytovateľa. Lokálne hostované modely sú možné, ale vyžadujú väčšie technické znalosti a nemusia produkovať také dobré výsledky ako komerčné modely.";
"ai_disclaimer_point9" = "Poskytovatelia AI účtujú za použitie API. Odhady nákladov zobrazené v AndBible sú približné — vždy si overte skutočné poplatky vo fakturácii vášho poskytovateľa.";
"ai_disclaimer_responsibility" = "Napriek tomu sú to stále výkonné nástroje — a s veľkou mocou prichádza veľká zodpovednosť. Majte prosím na pamäti nasledovné.";
