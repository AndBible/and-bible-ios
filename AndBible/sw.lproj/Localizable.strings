"ai_disclaimer_dialog_title" = "Zana za AI — Taarifa Muhimu";
"ai_disclaimer_intro" = "Zana za AI zinaweza kutajirisha sana uzoefu wako wa masomo ya Biblia na kufungua njia mpya za kushiriki na Maandiko.";
"ai_disclaimer_point1" = "AI inaweza kufanya makosa, ikiwemo \"udanganyifu\" (kutoa kwa ujasiri taarifa za uwongo au zilizobuniwa). Usikubali matokeo yake bila kufikiri.";
"ai_disclaimer_point2" = "Majibu ya AI yanaweza kuakisi upendeleo kutoka kwa data yao ya mafunzo, yanaweza kupotosha kwa makusudi, au yanaweza kuwasilisha mtazamo fulani wa kidini kana kwamba ni wa kawaida au kamili.";
"ai_disclaimer_point3" = "Unajibika kwa jinsi unavyotumia maudhui yaliyoundwa na AI. Daima thibitisha matokeo dhidi ya Maandiko kabla ya kutegemea.";
"ai_disclaimer_point4" = "AndBible inajitahidi kufanya uthibitishaji kuwe rahisi (mfano. nukuu sahihi za vyanzo katika maoni), lakini jukumu la mwisho daima liko kwako.";
"ai_disclaimer_point5" = "\"Jaribu yote; shika lililo jema.\" (1 Wathesalonike 5:21)";
"ai_disclaimer_point6" = "Zana hizi hazina roho wala Roho Mtakatifu. Ni zana za usindikaji wa maandishi, si viongozi vya kiroho. Hazifai moja kwa moja kwa kuandaa mahubiri, ibada za kujitegemea, au maudhui mengine ya kiroho bila usimamizi makini wa binadamu, maombi, na uamuzi.";
"ai_disclaimer_point7" = "Zikitumiwa kwa hekima, zinaweza kunufaisha watumiaji wengi na matumizi mengi. Lakini ikiwa huna uhakika wa kukubali hatari, kuchagua kutotumia pia ni chaguo halali kabisa.";
"ai_disclaimer_point8" = "Data yako inatumwa kwa seva za mtoa huduma wako wa AI uliyechagua. Kwa kutumia ufunguo wa API, unakubali masharti na sera ya faragha ya mtoa huduma huyo. Mifano inayohifadhiwa binafsi inawezekana lakini inahitaji ujuzi wa kiufundi zaidi, na inaweza kutoa matokeo si mazuri kama mifano ya biashara.";
"ai_disclaimer_point9" = "Watoa huduma wa AI hutozea matumizi ya API. Makadirio ya gharama yanayoonyeshwa katika AndBible ni ya makadirio — daima angalia bili ya mtoa huduma wako kwa malipo halisi.";
