"ai_disclaimer_dialog_title" = "Alat AI — Informasi Penting";
"ai_disclaimer_intro" = "Alat AI dapat sangat memperkaya pengalaman studi Alkitab Anda dan membuka cara baru untuk berinteraksi dengan Kitab Suci.";
"ai_disclaimer_point1" = "AI dapat membuat kesalahan, termasuk \"halusinasi\" (menyatakan informasi palsu atau rekaan dengan yakin). Jangan pernah menerima keluarannya secara membabi buta.";
"ai_disclaimer_point2" = "Respons AI dapat mencerminkan bias dari data pelatihannya, bisa menyesatkan secara sengaja, atau mungkin menyajikan perspektif teologis tertentu seolah-olah itu netral atau lengkap.";
"ai_disclaimer_point3" = "Anda bertanggung jawab atas cara Anda menggunakan konten yang dihasilkan AI. Selalu verifikasi hasilnya dengan Kitab Suci sebelum mengandalkannya.";
"ai_disclaimer_point4" = "AndBible berusaha memudahkan verifikasi (misalnya kutipan sumber yang tepat dalam tafsiran), tetapi tanggung jawab akhir selalu ada pada Anda.";
"ai_disclaimer_point5" = "\"Ujilah segala sesuatu dan peganglah yang baik.\" (1 Tesalonika 5:21)";
"ai_disclaimer_point6" = "Alat-alat ini tidak memiliki jiwa dan tidak memiliki Roh Kudus. Alat-alat ini adalah alat pemrosesan teks, bukan panduan rohani. Alat-alat ini tidak cocok untuk langsung mempersiapkan khotbah, renungan, atau konten rohani lainnya tanpa pengawasan manusia yang cermat, doa, dan pertimbangan bijaksana.";
"ai_disclaimer_point7" = "Digunakan dengan bijaksana, alat-alat ini dapat bermanfaat bagi banyak pengguna dan berbagai kasus penggunaan. Tetapi jika Anda tidak yakin menerima risikonya, memilih untuk tidak menggunakannya juga merupakan pilihan yang sepenuhnya valid.";
"ai_disclaimer_point8" = "Data Anda dikirim ke server penyedia AI yang Anda pilih. Dengan menggunakan kunci API, Anda menerima syarat dan kebijakan privasi penyedia tersebut. Model yang dihosting sendiri memungkinkan tetapi memerlukan keahlian teknis lebih dan mungkin tidak menghasilkan hasil sebaik model komersial.";
"ai_disclaimer_point9" = "Penyedia AI mengenakan biaya untuk penggunaan API. Perkiraan biaya yang ditampilkan di AndBible bersifat perkiraan — selalu periksa tagihan penyedia Anda untuk biaya aktual.";
