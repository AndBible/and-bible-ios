"ai_disclaimer_approach" = "AndBible terutamanya menggunakan AI untuk memproses teks dari dokumen yang anda pasang — ulasan, kamus, dan modul lain — dan bukannya bergantung pada data latihan model sendiri.";
"ai_disclaimer_dialog_title" = "Alat AI — Maklumat Penting";
"ai_disclaimer_intro" = "Alat AI boleh sangat memperkayakan pengalaman kajian Alkitab anda dan membuka cara baharu untuk berinteraksi dengan Kitab Suci.";
"ai_disclaimer_point1" = "AI boleh membuat kesilapan, termasuk \"halusinasi\" (menyatakan maklumat palsu atau direka dengan yakin). Jangan menerima outputnya secara buta.";
"ai_disclaimer_point2" = "Respons AI boleh mencerminkan kecenderungan dari data latihan mereka, mungkin mengelirukan dengan sengaja, atau mungkin membentangkan perspektif teologi tertentu seolah-olah ia neutral atau lengkap.";
"ai_disclaimer_point3" = "Anda bertanggungjawab atas cara anda menggunakan kandungan yang dijana AI. Sentiasa sahkan hasilnya terhadap Kitab Suci sebelum bergantung padanya.";
"ai_disclaimer_point4" = "AndBible berusaha untuk memudahkan pengesahan (cth. petikan sumber yang tepat dalam ulasan), tetapi tanggungjawab muktamad sentiasa terletak pada anda.";
"ai_disclaimer_point5" = "\"Ujilah segala-galanya; peganglah yang baik.\" (1 Tesalonika 5:21)";
"ai_disclaimer_point6" = "Alat-alat ini tidak mempunyai jiwa dan tidak ada Roh Kudus. Ia adalah alat pemprosesan teks, bukan panduan rohani. Ia tidak sesuai untuk menyediakan khotbah, renungan, atau kandungan rohani lain secara langsung tanpa pengawasan manusia yang teliti, doa, dan kebijaksanaan.";
"ai_disclaimer_point7" = "Digunakan dengan bijak, ia boleh memberi manfaat kepada ramai pengguna dan kes penggunaan. Tetapi jika anda tidak pasti tentang menerima risiko, memilih untuk tidak menggunakannya juga merupakan pilihan yang sah sepenuhnya.";
"ai_disclaimer_point8" = "Data anda dihantar ke pelayan penyedia AI yang anda pilih. Dengan menggunakan kunci API, anda menerima syarat dan dasar privasi penyedia tersebut. Model yang di-hos sendiri adalah mungkin tetapi memerlukan kepakaran teknikal yang lebih, dan mungkin tidak menghasilkan keputusan sebaik model komersial.";
"ai_disclaimer_point9" = "Penyedia AI mengenakan bayaran untuk penggunaan API. Anggaran kos yang ditunjukkan dalam AndBible adalah anggaran — sentiasa semak pengebilan penyedia anda untuk caj sebenar.";
"ai_disclaimer_responsibility" = "Walau bagaimanapun, ia masih merupakan alat yang berkuasa — dan dengan kuasa yang besar datang tanggungjawab yang besar. Sila ingat perkara berikut.";
