"ai_disclaimer_point1" = "AI ले गल्तीहरू गर्न सक्छ, जसमा \"hallucinations\" (झूटो वा बनाइएको जानकारी आत्मविश्वासका साथ भन्नु) समावेश छ। कहिल्यै अन्धाधुन्ध यसको आउटपुट स्वीकार नगर्नुहोस्।";
"ai_disclaimer_point2" = "AI प्रतिक्रियाहरूले तिनीहरूको प्रशिक्षण डेटाका पूर्वाग्रहहरू प्रतिबिम्बित गर्न सक्छन्, जानाजानी भ्रामक हुन सक्छन्, वा विशेष धर्मशास्त्रीय दृष्टिकोण तटस्थ वा पूर्ण रूपमा प्रस्तुत गर्न सक्छन्।";
"ai_disclaimer_point3" = "AI-उत्पन्न सामग्री कसरी प्रयोग गर्ने भन्ने तपाईं जिम्मेवार हुनुहुन्छ। तिनीहरूमा भर पर्नुअघि सधैं धर्मग्रन्थविरुद्ध परिणामहरू प्रमाणित गर्नुहोस्।";
"ai_disclaimer_point4" = "AndBible ले प्रमाणीकरण सजिलो बनाउन प्रयास गर्छ (उदाहरणका लागि, टिप्पणीहरूमा सटीक स्रोत उद्धरणहरू), तर अन्तिम जिम्मेवारी सधैं तपाईंसँग रहन्छ।";
"ai_disclaimer_point5" = "\"सबै कुरा परीक्षण गर्नुहोस्; जो असल छ त्यो थाम्नुहोस्।\" (१ थेस्सलोनिकी ५:२१)";
"ai_disclaimer_point6" = "यी उपकरणहरूसँग आत्मा वा पवित्र आत्मा छैन। तिनीहरू पाठ-प्रशोधन उपकरणहरू हुन्, आत्मिक मार्गदर्शकहरू होइनन्। सावधानीपूर्वक मानवीय निरीक्षण, प्रार्थना, र विवेक बिना धर्म प्रवचन, भक्तिमय सामग्री, वा अन्य आत्मिक सामग्री सीधै तयार गर्नका लागि उपयुक्त छैनन्।";
"ai_disclaimer_point7" = "बुद्धिमानीसँग प्रयोग गरेमा, तिनीहरूले धेरै प्रयोगकर्ताहरू र प्रयोगका मामलाहरूलाई फाइदा पुर्‍याउन सक्छन्। तर यदि तपाईं जोखिमहरू स्वीकार गर्नमा अनिश्चित हुनुहुन्छ भने, तिनीहरू प्रयोग नगर्नु पनि पूर्ण रूपमा वैध विकल्प हो।";
"ai_disclaimer_point8" = "तपाईंको डेटा तपाईंले छानेको AI प्रदायकका सर्भरहरूमा पठाइन्छ। API कुञ्जी प्रयोग गरेर, तपाईं त्यो प्रदायकको सर्तहरू र गोपनीयता नीति स्वीकार गर्नुहुन्छ। स्व-होस्ट गरिएका मोडलहरू सम्भव छन् तर बढी प्राविधिक विशेषज्ञता आवश्यक छ र व्यावसायिक मोडलहरूजस्तो राम्रा परिणामहरू नदिन सक्छन्।";
