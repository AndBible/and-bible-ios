"speak_help_auto_bookmark" = "பேச்சு இடைநிறுத்தப்படும்போதோ அல்லது நிறுத்தப்படும்போதோ பேச்சு புக்மார்க் தானாக சேர்க்கப்படும். இவ்வாறு தானாக சேர்க்கப்படும் புக்மார்க்குகளுக்கு சிறப்பு ஸ்பீக் லேபிளிடப்படும். நீங்கள் பேச்சுப் புக்மார்க்கில் தொடங்கினால், அடுத்த முறை நீங்கள் இடைநிறுத்தும் அல்லது நிறுத்தும் வசனத்திற்கு புக்மார்க் நகர்த்தப்படும். இது பேச்சு லேபிள்களுக்கு மட்டுமே பொருந்தும் பிற லெவல்கள் அப்படியே இருக்கும்.";
"speak_help_playback_settings" = "இதனை தேர்வு செய்தால், சிறப்பு வாசிப்பு அமைப்புகள் (\"வாசிப்பு அமைப்புகள்\" அடியில் பேசு திரையில்) வாசிப்பு புக் மார்க்குகளில் சேமிக்கப்படும். நீங்கள் வாசிப்பை வாசிப்பு புக் மார்க்குக்களில் இருந்து தொடரும்போது அதன் அமைப்புகள் புக்மாக்கிலிருந்து எடுக்கப்படும்.";
"speak_help_playback_settings_example" = "எடுத்துக்காட்டாக நீங்கள் தொடக்க நூல் மற்றும் உரோமையர் ஆகியவற்றை வாசிக்க கேட்கும் போது தொடக்க நூலினை விரைவாக அதிகார மாற்ற அறிவிப்புகள் இல்லாமலும், உரோமையரை அதிகாரமாற்ற அறிவிப்புகளோடும் கேட்க விரும்பினால் இந்த நூல்களுக்கு வெவ்வேறு வாசிப்பு அமைப்புகளை நீங்கள் தேர்வு செய்யலாம். இந்த அமைப்புகள் சேமிக்கப்படும்போது அவற்றிற்குரிய புக் மார்க்குகளில் அவை சேமிக்கப்படும்.";
