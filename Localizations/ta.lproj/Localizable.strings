"help_contextmenus_text" = "நீண்ட நேரம் அழுத்தினால் சூழல் மெனு அல்லது செயல் முறை பல காட்சிகளில் திறக்கும்.. தற்போதைய வசனத்தைப் பாதிக்கும் செயல்களுக்கான செயல் பயன்முறையைத் திறக்க பைபிள் காட்சியில் நீண்ட நேரம் அழுத்தவும்.. ஆவணத்தைத் தேர்ந்தெடு அல்லது பதிவிறக்கம் என்பதன் பட்டியல் பார்வையில் உள்ள ஆவண உருப்படியை நீண்ட நேரம் அழுத்தி ஆவணத்தை நீக்கலாம் அல்லது தகவலைப் பார்க்கவும். லேபிள்களைச் சேர்க்க அல்லது புக்மார்க்கை நீக்க புக்மார்க்குகள் பட்டியலில் புக்மார்க்கை நீண்ட நேரம் அழுத்தவும். நடப்பு சாளரம், புதிய சாளரம் அல்லது சிறப்பு இணைப்புகள் சாளரத்தில் இணைப்புகளைத் திறக்க விரும்பினால், இணைப்புகளை நீண்ட நேரம் அழுத்தவும்.";
"help_contextmenus_title" = "சூழல் மெனுக்கள்";
"help_hidden_features_text" = "பணியிடத்தினை தேர்வு செய்ய கருவிப்பட்டியில் இருந்து கீழே ஸ்வைப் செய்யவும்.. சாளரத்தைக் குறைக்க சாளர பொத்தானை நீண்ட நேரம் அழுத்தவும். பேச்சு அமைப்புகளுக்கு விரைவாகச் செல்ல, பேச்சு கருவிப்பட்டி பொத்தானை நீண்ட நேரம் அழுத்தவும்.. ஆவணத் தேர்விக்குச் செல்ல கருவிப்பட்டியில் வசன இருப்பிடத் தலைப்பை நீண்ட நேரம் அழுத்தவும்.. வரலாறு பட்டியலை அணுக பின் பொத்தானை நீண்ட நேரம் அழுத்தவும்.";
"help_hidden_features_title" = "மறைக்கப்பட்ட குறுக்கு வழிகள்";
"help_nav_text" = "முந்தைய அல்லது அடுத்த அதிகாரத்திற்கு செல்ல உங்கள் விரலால் திரையை வருடவும். முழு திரை (சாளரம் என்றே அழைக்கப்படுகின்றது) பயன்முறைக்கு செல்லவோ அல்லது அதிலிருந்து வெளியேறவும் விவிலிய உரையினை இரு முறை தட்டவும். பிளவுதிரை முறையில் வலது மேல் மூலையில் மெனு பொத்தான்கள் இருக்கும், இவை சாளரத்திற்கான தனிப் பயன்முறைகளையோ அல்லது சாளரத்தின் தோற்றத்தையும் நடத்தையையும் மாற்ற உதவும்.";
"help_nav_title" = "வழிசெலுத்தல்";
"help_search_text2" = "தேடல் உரையில் *, AND, OR, NOT போன்ற சிறப்பு எழுத்துகளை சேர்க்கலாம்";
"help_search_title" = "தேடல்";
"help_window_pinning_text" = "விருப்பங்கள் மெனுவிலிருந்து சாளர பின்னிங்கை இயக்கலாம் (வலது மேல் மூலையில் உள்ள மூன்று புள்ளிகள்). சாளர பின்னிங் இயக்கப்பட்டிருந்தால், விவிலியப் பார்வையில் பல பின் செய்யப்பட்ட சாளரங்களைக் காட்டலாம், ஆயினும் பின் செய்யப்படாத ஒரே ஒரு சாளரம் மட்டுமே காட்ட இயலும். பின் செய்யப்பட்ட சாளரங்கள் முதலில் காட்டப்படும், பின்னர் பின் செய்யப்படாத சாளரங்கள் காட்டப்படும். நீங்கள் விவிலியத்தை பின் செய்யப்பட்ட சாளரங்களிலும், விளக்க உரைகள் மற்றும் வரைபடங்கள் போன்றவற்றை பின் செய்யாத சாளரங்களில் திறக்கலாம். இதன் மூலம் நீங்கள் விவிலியத்தை எப்பொழுதும் திறந்து வைத்திருக்கலாம், அதேசமயம் விவிலியத்தைப் படிக்கும்போது விளக்க உரைகள் போன்றவற்றை விரைவாக மாற்றலாம்.";
