"global_tool_permissions_title" = "இயல்புநிலை கருவி அமைப்புகள்";
"help_ai_connection_text" = "உங்கள் AI வழங்குனர்கள், மாடல்கள், அனுமதிகள் மற்றும் பிற இணைப்பு விருப்பங்களை இங்கே அமைக்கவும். ஒவ்வொரு வழங்குனருக்கும் அதன் சொந்த API திறவுகோல் தேவை. பல வழங்குனர்களை சேர்க்கலாம் மற்றும் இயல்புநிலை மாடலை தேர்வு செய்யலாம்.";
"help_ai_document_filter_text" = "AI முகவர் படிக்கக்கூடிய விவிலியங்கள், விளக்க உரைகள் மற்றும் பிற தொகுதிகளை வரம்பிடவும். இயல்பாக AI நிறுவப்பட்ட அனைத்து தொகுதிகளையும் பார்க்கும்; குறிப்பிட்ட மூலங்களை மட்டும் கருத்தில் கொள்ள வேண்டும் என்றால் வடிகட்டுவது சத்தத்தையும் செலவையும் குறைக்க உதவும்.";
"help_ai_models_text" = "இந்த வழங்குனரின் மாடல்களை நிர்வகிக்கவும். புதிய வெளியீடுகளை பெற வழங்குனரின் API இலிருந்து மாடல் பட்டியலை புதுப்பிக்கலாம், அல்லது பட்டியலில் இல்லா மாடல் பெயரை கைமுறையாக சேர்க்கலாம்.";
"help_ai_providers_text" = "AI வழங்குனர்களை (Google Gemini, OpenAI, Anthropic, முதலியன) நிர்வகிக்கவும். ஒவ்வொரு வழங்குனருக்கும் அதன் சொந்த API திறவுகோல் தேவை. பல வழங்குனர்களை சேர்க்கலாம் மற்றும் குறிப்பிட்ட வரைவுகளுக்கு வேறு வேறு வழங்குனர்களை ஒதுக்கலாம்.";
"help_ai_settings_text" = "AI அமைப்புகள் என்பது உங்கள் வரைவுகள் மற்றும் வகைகளை நிர்வகிக்கும் இடம். இங்கிருந்து புதிய வரைவுகளை உருவாக்கலாம், அவற்றை வகைகளாக ஒழுங்கமைக்கலாம், CSV ஆக இறக்குமதி/ஏற்றுமதி செய்யலாம், கூடுதல் வரைவு தொகுப்புகளை நிறுவலாம், மற்றும் AI இணைப்பு அமைப்புகளை அணுகலாம்.";
"help_global_tool_permissions_text" = "தனிப்பட்ட AI கருவிகளுக்கான அனுமதிகளை அமைக்கவும். ஒவ்வொரு படிக்கும் கருவிக்கும், AI அதை பயன்படுத்தலாமா என்பதை (இயக்கப்பட்டது அல்லது முடக்கப்பட்டது) தேர்வு செய்யவும். ஒவ்வொரு எழுதும் கருவிக்கும், எப்போதும் அனுமதி, எப்போதும் மறுக்கவும், அல்லது கேட்கவும் (இது AI இணைப்பு அமைப்புகளில் அமைக்கப்பட்ட உலகளாவிய அனுமதி முறைக்கு திரும்பும்) ஆகியவற்றில் ஒன்றை தேர்வு செய்யவும்.";
