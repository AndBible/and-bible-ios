"help_bookmarks_title" = "Straničnici i moje bilješke";
"help_contextmenus_text" = "Dugi pritisak na nekim pregledima otvara ovisni izbornik ili način radnji. Dugi pritisak na pregledu Biblije otvara način radnji za radnje koje se odnose na trenutni redak. Dugi pritisak na dokument u pregledu liste Odaberi dokument ili Preuzimanja za brisanje dokumenta ili informacije o dokumentu. Dugi pritisak na straničnik u listi straničnika za dodavanje oznaka ili brisanje straničnika. Dugi pritisak na veze za izbor otvaranja u trenutnom prozoru, novom prozoru ili u prozoru za posebne veze.";
"help_contextmenus_title" = "Ovisni izbornik";
"help_hidden_features_text" = "Prevucite prema dolje od naslovne trake da odaberete radnu površinu. Dugo pritisnite gumb prozora da ga lako smanjite. Dugo pritisnite liniju alata govora za podešavanja izgovaranja. Dugo pritisnite naslov lokacije retka da skočite na izbor dokumenata. Dugo pritisnite gumb Natrag da biste pristupili Povijesti.";
"help_hidden_features_title" = "Skriveni prečaci";
"help_nav_text" = "Prelazak na sljedeće ili prethodno poglavlje prevlačeći prstom po zaslonu. Dvostruki dodir na tekst u Bibliji kontrolira način cijelog zaslona. Podijeljeni zasloni (također poznati kao prozori) imaju gumb izbornika u gornjem desnom kutu, ono Vam omogućava da upotrijebite nekoliko funkcija specifičnih za prozor i prilagodite njegov izgled i ponašanje.";
"help_nav_title" = "Navigacija";
"help_search_text2" = "Tekst za pretraživanje može sadržavati posebne znakove kao *, AND, OR, NOT";
"help_search_title" = "Pretraži";
"help_window_pinning_text" = "Možete omogućiti isticanje prozora iz izbornika opcije (3-točke, gornji desni kut). Ako je isticanje prozora omogućeno, možete prikazivati mnogo istaknutih prozora na pregledu Biblije, ali samo jedan neistaknuti prozor. Istaknuti prozori su prikazani prvi, pa tek onda neistaknuti prozori. Mogli biste otvoriti biblijske dokumente kao istaknute prozore, a komentare i karte itd. kao neistaknute prozore. Tada ćete sa lakoćom imati biblijske dokumente uvijek otvorene i brzo se prebacivati sa komentara i ostalog dodatnog materijala kada proučavate Bibliju.";
"help_window_pinning_title" = "Isticanje prozora";
